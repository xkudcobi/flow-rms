# SQLite (geliştirme). Üretimde Postgres'e geçmek için provider'ı ve URL'i değiştirin.
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="degistir-bu-gizli-anahtari-uretimde"
JWT_EXPIRES_IN="12h"

# API
PORT=3011
CORS_ORIGIN="http://localhost:5173"

# ── Uzaktan erişim (Cloudflare Tunnel) ────────────────────────────────────
# Varsayılan KAPALI: sistem yalnızca restoranın yerel ağında görünür.
#
#   off   — Sadece yerel ağ. Modem/port ayarı yok, internete kapalı.
#   quick — trycloudflare.com üzerinden geçici adres. Ücretsiz, domain
#           gerekmez; adres her başlatmada değişir ve Cloudflare bunu
#           "yalnız test" için sunar. Deneme amaçlı.
#   named — Kendi domain'inizdeki kalıcı adres. TUNNEL_TOKEN gerekir.
#
# Kurulum: npm run remote:setup   (bu değerleri sizin yerinize doldurur)
#
# ÖNEMLİ: off dışına çıkıldığında sunucu, varsayılan şifreler veya örnek
# JWT_SECRET varsa BAŞLAMAZ. Düzeltmek için: npm run remote:harden
REMOTE_MODE=off
# named modunda işletmenin adresi (ör. bistro.flowrms.com)
REMOTE_HOSTNAME=
# named modunda Cloudflare tunnel token'ı — GİZLİ, paylaşmayın, depoya koymayın.
TUNNEL_TOKEN=

# Mutfak yazıcısı (ESC/POS, ağ üzerinden raw TCP). Tanımlı değilse fişler
# yazdırılmaz, sadece önizleme sunucu logunda görünür.
# Tek yazıcı: PRINTER_HOST=192.168.1.50  PRINTER_PORT=9100
# İstasyon bazlı ayrı yazıcı (opsiyonel): PRINTER_HOST_IZGARA=..., PRINTER_HOST_BAR=...
# PRINTER_HOST=192.168.1.50
# PRINTER_PORT=9100

# İşletme adı (fiş başlığı) — kendi restoranınızın adı
# BUSINESS_NAME="RESTORANINIZIN ADI"

# ÖKC (yeni nesil yazarkasa) sağlayıcısı: simulation | gmp3
# gmp3 gerçek cihaz gerektirir (marka/model + SDK). Varsayılan: simulation
FISCAL_PROVIDER=simulation

# e-Fatura sağlayıcısı: simulation | entegrator
# entegrator gerçek GİB onaylı entegratör + API anahtarı gerektirir. Varsayılan: simulation
EINVOICE_PROVIDER=simulation

# AI asistan (opsiyonel, tamamen local & ücretsiz): none | ollama
# Öngörüler motoru bundan bağımsız her zaman çalışır. Asistan sohbeti için:
#   1) https://ollama.com adresinden Ollama'yı kurun
#   2) Terminalde:  ollama pull llama3.2   (model indir, ~2 GB)
#   3) AI_PROVIDER=ollama yapın ve sunucuyu yeniden başlatın
# Kurulu değilse AI_PROVIDER=none bırakın; asistan devre dışı görünür, hata vermez.
AI_PROVIDER=none
AI_URL=http://localhost:11434
AI_MODEL=llama3.2

# Google yorumları: none | google | simulation
# google: Google Places API anahtarı + Place ID gerekir (yalnız en yeni ~5 yorumu verir).
#   1) Google Cloud Console'da "Places API"yi etkinleştirin, bir API anahtarı alın.
#   2) İşletmenizin Place ID'sini bulun: https://developers.google.com/maps/documentation/places/web-service/place-id
#   3) REVIEWS_PROVIDER=google yapın, aşağıdaki iki değeri doldurun.
# simulation: anahtarsız test/demo (sahte yorumlar). none: kapalı.
REVIEWS_PROVIDER=none
REVIEWS_POLL_MIN=30
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=

# Graphify oto-hafıza (kendi kendini güncelleyen kod+veri grafiği): on | off
# on: canlı veri ilişkileri (sipariş-ürün-stok-müşteri-yorum) çalışma anında
#   öğrenilir, ~GRAPH_FLUSH_MS'de bir data-graph.json'a yazılıp kod grafiğiyle
#   birleştirilir (merged-graph.json); AI asistan Graph-RAG olarak kullanır.
# Gereksinim: pip ile "graphifyy" kurulu ve `graphify` PATH'te olmalı.
# Kapalıyken tüm sistem etkilenmez (no-op).
GRAPH_MEMORY=on
# Debounce: kaç ms'de bir diske yazıp merge edilsin (varsayılan 30000).
GRAPH_FLUSH_MS=30000
# graphify-out dizini (varsayılan: sunucu cwd'sinin bir üstündeki graphify-out).
# GRAPH_OUT_DIR=
